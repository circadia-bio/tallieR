Package: tallieR
Title: Import and Score ScoreMe App Questionnaire Data
Version: 0.2.0
Authors@R: c(
    person("Lucas", "França",
           email = "lucas.franca@northumbria.ac.uk",
           role = c("aut", "cre"),
           comment = c(ORCID = "0000-0003-0853-1319")),
    person("Mario", "Leocadio-Miguel",
